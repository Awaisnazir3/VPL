[Unit]
Description=VPL Portal & CRM Backend API Service
After=network.target mysqld.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/vpl_portal/backend
ExecStart=/usr/bin/node /var/www/vpl_portal/backend/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
